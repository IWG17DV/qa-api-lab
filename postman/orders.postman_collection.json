{
  "info": {
    "_postman_id": "8c2f80ad-bc11-4cf4-8bb9-a950204a572e",
    "name": "Orders API - Variant 10",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" }
  ],
  "item": [
    {
      "name": "Login as Bob",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"bob@example.com\",\"password\":\"Secret123\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Bob login succeeds', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('userToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Bob order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"sku\":\"SKU-A\",\"price\":500,\"qty\":1}]}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order is created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login as administrator",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@example.com\",\"password\":\"Admin123\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Administrator login succeeds', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /admin/orders as administrator",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/admin/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Administrator receives all orders', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /admin/orders as regular user",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
        "url": "{{baseUrl}}/admin/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Regular user is forbidden', () => pm.response.to.have.status(403));",
              "pm.test('Forbidden response has the expected code', () => {",
              "  pm.expect(pm.response.json().code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
